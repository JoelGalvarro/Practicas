#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

double factorial(int n) {
    double fac = 1.0;
    for (int i = 1; i <= n; i++) fac *= i;
    return fac;
}

double calcularSerie10(double x, int n) {
    double suma = 0.0;
    int signo = 1;
    for (int i = 1; i <= n; i += 2) {
        suma += signo * (pow(x, i) / factorial(i));
        signo *= -1;
    }
    return suma;
}

int main() {
    double x;
    int n;
    cout << "Ingrese X y N (impar): ";
    cin >> x >> n;

    if (n % 2 == 0 || n < 1) {
        cout << "N debe ser un entero positivo impar." << endl;
        return 0;
    }

    cout << fixed << setprecision(4);
    cout << "Suma de la serie: " << calcularSerie10(x, n) << endl;
    return 0;
}
