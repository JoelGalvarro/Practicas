#include <iostream>
using namespace std;

int leerNumero() {
    int n;
    do {
        cout << "Ingrese un numero entero positivo N: ";
        cin >> n;
        if (n <= 0) {
            cout << "Error: Debe ingresar un numero entero positivo." << endl;
        }
    } while (n <= 0);
    return n;
}

long long sumarHastaN(int n) {
    long long suma = 0;
    for (int i = 1; i <= n; i++) {
        suma += i;
    }
    return suma;
}

int contarDigitos(int n) {
    int contador = 0;
    while (n > 0) {
        contador++;
        n /= 10;
    }
    return contador;
}

int sumarDigitos(int n) {
    int suma = 0;
    do {
        suma += n % 10;
        n /= 10;
    } while (n > 0);
    return suma;
}

void mostrarResultados(int n, long long sumaN, int cantDigitos, int sumaDig) {
    cout << "\n--- Resultados para N = " << n << " ---" << endl;
    cout << "Suma de 1 hasta N (for): " << sumaN << endl;
    cout << "Cantidad de digitos (while): " << cantDigitos << endl;
    cout << "Suma de sus digitos (do-while): " << sumaDig << endl;
}

int main() {
    int n = leerNumero();
    long long sumaN = sumarHastaN(n);
    int cantDigitos = contarDigitos(n);
    int sumaDig = sumarDigitos(n);

    mostrarResultados(n, sumaN, cantDigitos, sumaDig);
    return 0;
}
