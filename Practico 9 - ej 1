void mostrarResumen(const string productos[], const string marcas[], const int cantidades[], int total) {
    if (total <= 0) {
        cout << "El inventario esta vacio. No hay resumen disponible.\n";
        return;
    }

    int totalUnidades = 0;
    int idxMayorStock = 0;

    for (int i = 0; i < total; i++) {
        totalUnidades += cantidades[i];
        if (cantidades[i] > cantidades[idxMayorStock]) {
            idxMayorStock = i;
        }
    }

    cout << "\n================ RESUMEN DE INVENTARIO ================\n"
         << "Cantidad de productos distintos : " << total << "\n"
         << "Total de unidades en stock     : " << totalUnidades << "\n"
         << "Producto con mayor stock       : " << productos[idxMayorStock]
         << " (" << marcas[idxMayorStock] << ") con " << cantidades[idxMayorStock] << " unidades\n"
         << "=======================================================\n";
}
