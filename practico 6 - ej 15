#include <iostream>
using namespace std;

bool esBisiesto(int anio) {
    return (anio % 4 == 0 && anio % 100 != 0) || (anio % 400 == 0);
}

int main() {
    int anio;
    cout << "Ingrese un anio: ";
    cin >> anio;

    if (esBisiesto(anio)) {
        cout << anio << " es bisiesto." << endl;
    } else {
        cout << anio << " no es bisiesto." << endl;
    }
    return 0;
}
