#include <iostream>
#include <cmath>
using namespace std;

int sumarDigitos(long long n) {
    n = abs(n);
    int suma = 0;
    while (n > 0) {
        suma += n % 10;
        n /= 10;
    }
    return suma;
}

int main() {
    long long n;
    cout << "Ingrese un numero entero: ";
    cin >> n;

    cout << "La suma de los digitos es: " << sumarDigitos(n) << endl;
    return 0;
}
