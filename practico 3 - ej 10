#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

int main() {
    double x, suma = 0.0;
    int n, signo = 1;
    cout << "Ingrese X y N (impar): ";
    cin >> x >> n;

    if (n % 2 == 0 || n < 1) {
        cout << "N debe ser un entero positivo impar." << endl;
        return 0;
    }

    for (int i = 1; i <= n; i += 2) {
        double fac = 1.0;
        for (int j = 1; j <= i; j++) {
            fac *= j;
        }
        suma += signo * (pow(x, i) / fac);
        signo *= -1;
    }

    cout << fixed << setprecision(4);
    cout << "Suma de la serie: " << suma << endl;
    return 0;
}
