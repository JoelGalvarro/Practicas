#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Ingrese la posicion N (>= 0): ";
    cin >> n;

    if (n < 0) {
        cout << "Posicion invalida." << endl;
        return 0;
    }

    unsigned long long f0 = 1, f1 = 1, fi = 1;
    if (n == 0 || n == 1) {
        fi = 1;
    } else {
        for (int i = 2; i <= n; i++) {
            fi = f0 + f1;
            f0 = f1;
            f1 = fi;
        }
    }

    cout << "F(" << n << ") = " << fi << endl;
    return 0;
}
