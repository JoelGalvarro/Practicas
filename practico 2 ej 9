#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    double c, f;
    cout << "Ingrese la temperatura en grados Celsius: ";
    cin >> c;

    f = (c * 9.0 / 5.0) + 32.0;
    cout << fixed << setprecision(2);
    cout << "Temperatura en Fahrenheit: " << f << endl;
    return 0;
}
