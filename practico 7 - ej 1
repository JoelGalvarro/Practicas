#include <iostream>
#include <iomanip>
#include <string>
using namespace std;

double calcularPromedio(int cantidad) {
    double nota, suma = 0.0;
    for (int i = 1; i <= cantidad; i++) {
        do {
            cout << "Ingrese la nota de la evaluacion " << i << " (0 - 100): ";
            cin >> nota;
            if (nota < 0 || nota > 100) {
                cout << "Error: La nota debe estar entre 0 y 100." << endl;
            }
        } while (nota < 0 || nota > 100);
        suma += nota;
    }
    return suma / cantidad;
}

string determinarEstado(double promedio) {
    if (promedio >= 51.0) {
        return "Aprobado";
    } else {
        return "Reprobado";
    }
}

int main() {
    int n;
    do {
        cout << "Ingrese la cantidad de evaluaciones: ";
        cin >> n;
        if (n <= 0) {
            cout << "Error: La cantidad debe ser mayor a 0." << endl;
        }
    } while (n <= 0);

    double promedio = calcularPromedio(n);
    string estado = determinarEstado(promedio);

    cout << fixed << setprecision(2);
    cout << "\nPromedio obtenido: " << promedio << endl;
    cout << "Estado del estudiante: " << estado << endl;
    return 0;
}
