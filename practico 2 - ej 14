#include <iostream>
#include <cctype>
using namespace std;

int main() {
    char letra;
    cout << "Ingrese una letra: ";
    cin >> letra;

    letra = tolower(letra);
    if (isalpha(letra)) {
        if (letra == 'a' || letra == 'e' || letra == 'i' || letra == 'o' || letra == 'u') {
            cout << "Es una vocal." << endl;
        } else {
            cout << "Es una consonante." << endl;
        }
    } else {
        cout << "No ingreso una letra valida." << endl;
    }
    return 0;
}
