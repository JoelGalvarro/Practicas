#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

double factorial(int n) {
    double fac = 1.0;
    for (int i = 1; i <= n; i++) fac *= i;
    return fac;
}

double calcularSerie9(double x, int n) {
    double suma = 0.0;
    int signo = 1;
    for (int i = 1; i <= n; i++) {
        suma += signo * (pow(x, i) / factorial(i));
        signo *= -1;
    }
    return suma;
}

int main() {
    double x;
    int n;
    cout << "Ingrese X y N: ";
    cin >> x >> n;

    cout << fixed << setprecision(4);
    cout << "Suma de la serie: " << calcularSerie9(x, n) << endl;
    return 0;
}
