#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

int main() {
    double x, suma = 0.0, fac = 1.0;
    int n, signo = 1;
    cout << "Ingrese X y N: ";
    cin >> x >> n;

    for (int i = 1; i <= n; i++) {
        fac *= i;
        suma += signo * (pow(x, i) / fac);
        signo *= -1;
    }

    cout << fixed << setprecision(4);
    cout << "Suma de la serie: " << suma << endl;
    return 0;
}
