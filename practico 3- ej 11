#include <iostream>
#include <cmath>
using namespace std;

int main() {
    int a, b, resto;
    cout << "Ingrese dos numeros enteros: ";
    cin >> a >> b;

    a = abs(a);
    b = abs(b);

    while (b != 0) {
        resto = a % b;
        a = b;
        b = resto;
    }

    cout << "El MCD es: " << a << endl;
    return 0;
}
