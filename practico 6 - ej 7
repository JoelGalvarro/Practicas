#include <iostream>
#include <iomanip>
using namespace std;

double celsiusAFahrenheit(double c) {
    return (c * 9.0 / 5.0) + 32.0;
}

double fahrenheitACelsius(double f) {
    return (f - 32.0) * 5.0 / 9.0;
}

int main() {
    int opcion;
    double temp;

    cout << "1) Celsius a Fahrenheit\n2) Fahrenheit a Celsius\nElija una opcion: ";
    cin >> opcion;
    cout << "Ingrese la temperatura: ";
    cin >> temp;

    cout << fixed << setprecision(2);
    if (opcion == 1) {
        cout << "Resultado: " << celsiusAFahrenheit(temp) << " F" << endl;
    } else if (opcion == 2) {
        cout << "Resultado: " << fahrenheitACelsius(temp) << " C" << endl;
    } else {
        cout << "Opcion no valida." << endl;
    }
    return 0;
}
