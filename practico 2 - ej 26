#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    double n1, n2, n3, prom;
    cout << "Ingrese las tres notas (sobre 100): ";
    cin >> n1 >> n2 >> n3;

    prom = (n1 + n2 + n3) / 3.0;
    cout << fixed << setprecision(2);
    cout << "Promedio: " << prom << endl;

    if (prom >= 90) {
        cout << "Estado: Aprobado con excelencia" << endl;
    } else if (prom >= 51) {
        cout << "Estado: Aprobado" << endl;
    } else {
        cout << "Estado: Reprobado" << endl;
    }
    return 0;
}
