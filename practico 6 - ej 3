#include <iostream>
using namespace std;

unsigned long long calcularFactorial(int n) {
    unsigned long long fac = 1;
    for (int i = 1; i <= n; i++) {
        fac *= i;
    }
    return fac;
}

int main() {
    int n;
    cout << "Ingrese un numero entero (>= 0): ";
    cin >> n;

    if (n < 0) {
        cout << "No existe factorial para numeros negativos." << endl;
    } else {
        cout << n << "! = " << calcularFactorial(n) << endl;
    }
    return 0;
}
