#include <iostream>
#include <cmath>
using namespace std;

int main() {
    long long n;
    int suma = 0;
    cout << "Ingrese un numero entero: ";
    cin >> n;

    n = abs(n);
    while (n > 0) {
        suma += n % 10;
        n /= 10;
    }

    cout << "La suma de los digitos es: " << suma << endl;
    return 0;
}
