#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Ingrese un numero entero: ";
    cin >> n;

    if (n % 3 == 0 && n % 5 == 0) {
        cout << "Es multiplo de 3 y de 5 al mismo tiempo." << endl;
    } else {
        cout << "No es multiplo de 3 y de 5 al mismo tiempo." << endl;
    }
    return 0;
}
