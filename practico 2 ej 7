#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    double precio, precioFinal;
    cout << "Ingrese el precio del producto: ";
    cin >> precio;

    precioFinal = precio * 0.90;
    cout << fixed << setprecision(2);
    cout << "Precio con 10% de descuento: " << precioFinal << endl;
    return 0;
}
