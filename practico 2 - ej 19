#include <iostream>
using namespace std;

int main() {
    int hora;
    cout << "Ingrese la hora actual (0 a 23): ";
    cin >> hora;

    if (hora < 0 || hora > 23) {
        cout << "Hora invalida." << endl;
    } else if (hora >= 6 && hora <= 11) {
        cout << "Buenos dias" << endl;
    } else if (hora >= 12 && hora <= 18) {
        cout << "Buenas tardes" << endl;
    } else {
        cout << "Buenas noches" << endl;
    }
    return 0;
}
