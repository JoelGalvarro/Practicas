#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

int main() {
    double x, suma = 0.0;
    int n;
    cout << "Ingrese X (real) y N (entero): ";
    cin >> x >> n;

    for (int i = 1; i <= n; i++) {
        suma += pow(x, i);
    }

    cout << fixed << setprecision(4);
    cout << "Suma de la serie: " << suma << endl;
    return 0;
}
