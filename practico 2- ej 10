#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

int main() {
    const double PI = acos(-1.0);
    double radio, area, perimetro;

    cout << "Ingrese el radio del circulo: ";
    cin >> radio;

    area = PI * pow(radio, 2);
    perimetro = 2 * PI * radio;

    cout << fixed << setprecision(2);
    cout << "Area: " << area << endl;
    cout << "Perimetro: " << perimetro << endl;
    return 0;
}
