#include <iostream>
#include <iomanip>
#include <string>
using namespace std;

int main() {
    int h, m;
    cout << "Ingrese la hora (0-23) y minutos (0-59): ";
    cin >> h >> m;

    if (h < 0 || h > 23 || m < 0 || m > 59) {
        cout << "Hora o minutos invalidos." << endl;
        return 0;
    }

    string periodo = (h >= 12) ? "PM" : "AM";
    int h12 = h % 12;
    if (h12 == 0) h12 = 12;

    cout << "Formato 12 horas: "
         << setw(2) << setfill('0') << h12 << ":"
         << setw(2) << setfill('0') << m << " " << periodo << endl;
    return 0;
}
