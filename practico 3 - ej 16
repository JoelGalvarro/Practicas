#include <iostream>
using namespace std;

int main() {
    int n, divisores = 0;
    cout << "Ingrese un numero entero: ";
    cin >> n;

    for (int i = 1; i <= n; i++) {
        if (n % i == 0) {
            divisores++;
        }
    }

    if (divisores == 2) {
        cout << n << " es un numero primo." << endl;
    } else {
        cout << n << " no es un numero primo." << endl;
    }
    return 0;
}
